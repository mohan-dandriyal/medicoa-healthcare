        "Faq": {
          "variants": {
            "MedicoAFaq2": {
              "id": "faq",
              "title": {
                "primary": "Frequently Asked",
                "highlight": "Questions"
              },
              "description": "Find quick answers to common questions about our pharmacy services, medications, prescriptions, and more.",
              "image": {
                "src": "/other/faq.webp",
                "alt": "Smiling pharmacist standing in a pharmacy"
              },
              "contactCard": {
                "title": "Still Have a Question?",
                "description": "We're here to help you anytime.",
                "icon": "chat",
                "link": "#contact"
              },
              "questions": [
                {
                  "id": 1,
                  "question": "What is the role of a pharmacist in healthcare?",
                  "answer": "A pharmacist ensures the safe and effective use of medications, provides guidance on proper dosage, checks for drug interactions, and supports your overall health and wellness."
                },
                {
                  "id": 2,
                  "question": "What if I miss a dose of my medication?",
                  "answer": "The correct action depends on your medication and how late the dose is. Check the patient information leaflet or ask your pharmacist. Do not take a double dose unless your healthcare professional specifically advises it."
                },
                {
                  "id": 3,
                  "question": "How should I store my medications?",
                  "answer": "Store medications according to their packaging instructions, away from excessive heat, moisture, and direct sunlight. Some medicines require refrigeration. Always keep medications out of reach of children."
                },
                {
                  "id": 4,
                  "question": "What are the signs of an allergic reaction to medication?",
                  "answer": "Possible signs include itching, rash, hives, or swelling. Difficulty breathing, swelling of the tongue or throat, or fainting can indicate a severe allergic reaction and require immediate emergency medical attention."
                },
                {
                  "id": 5,
                  "question": "What vaccines should I get as an adult?",
                  "answer": "Recommended vaccines depend on your age, medical history, occupation, and previous vaccinations. Consult your healthcare professional about routine and risk-based immunizations."
                },
                {
                  "id": 6,
                  "question": "What should I do if I experience a medication overdose?",
                  "answer": "Seek emergency medical assistance immediately if an overdose is suspected. Do not wait for symptoms to appear or induce vomiting unless a medical professional instructs you to do so. Keep the medication packaging available for emergency responders."
                }
              ]
            }
          }
        },
